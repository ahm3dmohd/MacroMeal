<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Meal Item</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>Add a new meal item</h1>
    <form action="/mealitems" method="post">
      <label for="name">Name:</label>
      <input type="text" name="name" id="name" required />

      <label for="description">Description:</label>
      <textarea name="description" id="description"></textarea>

      <label for="category">Category:</label>
      <select name="category" id="category" required>
        <option value="breakfast">Breakfast</option>
        <option value="lunch">Lunch</option>
        <option value="dinner">Dinner</option>
        <option value="snack">Snack</option>
      </select>

      <label for="price">Price ($):</label>
      <input type="number" step="0.01" min="0" name="price" id="price" required />

      <label for="calories">Calories:</label>
      <input type="number" min="0" name="calories" id="calories" required />

      <label for="protein">Protein (g):</label>
      <input type="number" min="0" name="protein" id="protein" required />

      <label for="carbs">Carbs (g):</label>
      <input type="number" min="0" name="carbs" id="carbs" required />

      <label for="fat">Fat (g):</label>
      <input type="number" min="0" name="fat" id="fat" required />

      <label for="available">Available:</label>
      <input type="checkbox" name="available" id="available" checked />

      <button type="submit">Create meal item</button>
    </form>
  </body>
</html>