<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: mealItem.name }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <article class="max-w-xl bg-white rounded-lg shadow p-6 sm:p-8">
        <h1 class="text-xl sm:text-2xl font-bold mb-2"><%= mealItem.name %></h1>
        <p class="text-gray-600 mb-4"><%= mealItem.description %></p>
        <p class="text-sm text-gray-500 mb-4">by <a href="/vendors/<%= mealItem.vendor._id %>" class="text-primary-700 hover:text-primary-800"><%= mealItem.vendor.username %></a></p>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 mb-6">
          <div>
            <dt class="text-sm font-semibold text-gray-500">Category</dt>
            <dd class="text-gray-900 capitalize"><%= mealItem.category %></dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-gray-500">Price</dt>
            <dd class="text-gray-900">$<%= mealItem.price %></dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-gray-500">Calories</dt>
            <dd class="text-gray-900"><%= mealItem.calories %></dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-gray-500">Protein</dt>
            <dd class="text-gray-900"><%= mealItem.protein %>g</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-gray-500">Carbs</dt>
            <dd class="text-gray-900"><%= mealItem.carbs %>g</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-gray-500">Fat</dt>
            <dd class="text-gray-900"><%= mealItem.fat %>g</dd>
          </div>
        </dl>

        <% if (user && mealItem.vendor._id.equals(user._id)) { %>
          <div class="flex gap-3">
            <a href="/mealitems/<%= mealItem._id %>/edit" class="inline-block bg-primary-700 hover:bg-primary-800 text-white font-semibold px-4 py-2 rounded-lg transition">Edit</a>
            <form action="/mealitems/<%= mealItem._id %>?_method=DELETE" method="post" onsubmit="return confirm('Delete this meal item? This cannot be undone.');">
              <button type="submit" class="bg-red-700 hover:bg-red-800 text-white font-semibold px-4 py-2 rounded-lg transition">Delete</button>
            </form>
          </div>
        <% } %>
      </article>
    </main>
  </body>
</html>
