<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'Edit Meal Item' }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <h1 class="text-2xl font-bold mb-6">Edit meal item</h1>
      <form action="/mealitems/<%= mealItem._id %>?_method=PUT" method="post" class="max-w-md bg-white rounded-lg shadow p-8 space-y-4">
        <div>
          <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">Name:</label>
          <input type="text" name="name" id="name" value="<%= mealItem.name %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div>
          <label for="description" class="block text-sm font-semibold text-gray-700 mb-1">Description:</label>
          <textarea name="description" id="description" class="block w-full rounded-md border border-gray-300 px-3 py-2 min-h-[6rem] focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600"><%= mealItem.description %></textarea>
        </div>

        <div>
          <label for="category" class="block text-sm font-semibold text-gray-700 mb-1">Category:</label>
          <select name="category" id="category" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600">
            <option value="breakfast" <%= mealItem.category === "breakfast" ? "selected" : "" %>>Breakfast</option>
            <option value="lunch" <%= mealItem.category === "lunch" ? "selected" : "" %>>Lunch</option>
            <option value="dinner" <%= mealItem.category === "dinner" ? "selected" : "" %>>Dinner</option>
            <option value="snack" <%= mealItem.category === "snack" ? "selected" : "" %>>Snack</option>
          </select>
        </div>

        <div>
          <label for="price" class="block text-sm font-semibold text-gray-700 mb-1">Price ($):</label>
          <input type="number" step="0.01" min="0" name="price" id="price" value="<%= mealItem.price %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div>
          <label for="calories" class="block text-sm font-semibold text-gray-700 mb-1">Calories:</label>
          <input type="number" min="0" name="calories" id="calories" value="<%= mealItem.calories %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div>
          <label for="protein" class="block text-sm font-semibold text-gray-700 mb-1">Protein (g):</label>
          <input type="number" min="0" name="protein" id="protein" value="<%= mealItem.protein %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div>
          <label for="carbs" class="block text-sm font-semibold text-gray-700 mb-1">Carbs (g):</label>
          <input type="number" min="0" name="carbs" id="carbs" value="<%= mealItem.carbs %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div>
          <label for="fat" class="block text-sm font-semibold text-gray-700 mb-1">Fat (g):</label>
          <input type="number" min="0" name="fat" id="fat" value="<%= mealItem.fat %>" required class="block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600" />
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" name="available" id="available" <%= mealItem.available ? "checked" : "" %> class="h-4 w-4 rounded border-gray-300 text-primary-700 focus:ring-primary-600" />
          <label for="available" class="text-sm font-semibold text-gray-700">Available</label>
        </div>

        <button type="submit" class="bg-primary-700 hover:bg-primary-800 text-white font-semibold px-5 py-2.5 rounded-lg transition">Update meal item</button>
      </form>
    </main>
  </body>
</html>
