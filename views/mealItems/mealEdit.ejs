<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Meal Item</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>Edit meal item</h1>
    <form action="/mealitems/<%= mealItem._id %>?_method=PUT" method="post">
      <label for="name">Name:</label>
      <input type="text" name="name" id="name" value="<%= mealItem.name %>" required />

      <label for="description">Description:</label>
      <textarea name="description" id="description"><%= mealItem.description %></textarea>

      <label for="category">Category:</label>
      <select name="category" id="category" required>
        <option value="breakfast" <%= mealItem.category === "breakfast" ? "selected" : "" %>>Breakfast</option>
        <option value="lunch" <%= mealItem.category === "lunch" ? "selected" : "" %>>Lunch</option>
        <option value="dinner" <%= mealItem.category === "dinner" ? "selected" : "" %>>Dinner</option>
        <option value="snack" <%= mealItem.category === "snack" ? "selected" : "" %>>Snack</option>
      </select>

      <label for="price">Price ($):</label>
      <input type="number" step="0.01" min="0" name="price" id="price" value="<%= mealItem.price %>" required />

      <label for="calories">Calories:</label>
      <input type="number" min="0" name="calories" id="calories" value="<%= mealItem.calories %>" required />

      <label for="protein">Protein (g):</label>
      <input type="number" min="0" name="protein" id="protein" value="<%= mealItem.protein %>" required />

      <label for="carbs">Carbs (g):</label>
      <input type="number" min="0" name="carbs" id="carbs" value="<%= mealItem.carbs %>" required />

      <label for="fat">Fat (g):</label>
      <input type="number" min="0" name="fat" id="fat" value="<%= mealItem.fat %>" required />

      <label for="available">Available:</label>
      <input type="checkbox" name="available" id="available" <%= mealItem.available ? "checked" : "" %> />

      <button type="submit">Update meal item</button>
    </form>
  </body>
</html>