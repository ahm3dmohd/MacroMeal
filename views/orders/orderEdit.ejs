<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'Edit Order' }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <h1 class="text-2xl font-bold mb-6">Edit order</h1>
      <form action="/orders/<%= order._id %>?_method=PUT" method="post" class="max-w-2xl bg-white rounded-lg shadow p-8 space-y-3">
        <% mealItems.forEach(function(mealItem) { %>
          <div class="flex items-center justify-between gap-4 border-b border-gray-100 pb-3">
            <input type="hidden" name="mealItemIds" value="<%= mealItem._id %>" />
            <label for="qty-<%= mealItem._id %>" class="text-sm text-gray-700">
              <span class="font-semibold"><%= mealItem.name %></span> — <%= mealItem.calories %> cal, <%= mealItem.price.toFixed(3) %> BHD
            </label>
            <input
              type="number"
              min="0"
              value="<%= quantityMap[mealItem._id.toString()] || 0 %>"
              name="quantities"
              id="qty-<%= mealItem._id %>"
              class="w-20 rounded-md border border-gray-300 px-2 py-1 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600"
            />
          </div>
        <% }) %>
        <button type="submit" class="bg-primary-700 hover:bg-primary-800 text-white font-semibold px-5 py-2.5 rounded-lg transition mt-4">Update order</button>
      </form>
    </main>
  </body>
</html>
