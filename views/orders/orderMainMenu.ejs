<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'My Orders' }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <h1 class="text-2xl font-bold mb-4">My Orders</h1>
      <a href="/orders/new" class="inline-block bg-primary-700 hover:bg-primary-800 text-white font-semibold px-5 py-2.5 rounded-lg mb-8 transition">Place a new order</a>

      <% if (orders.length === 0) { %>
        <p class="text-center text-gray-500 border border-dashed border-gray-300 rounded-lg py-12">You haven't placed any orders yet.</p>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% orders.forEach(function(order) { %>
            <div class="bg-white rounded-lg shadow p-6 hover:shadow-lg hover:-translate-y-1 transition">
              <span class="inline-block text-white text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-3 <%= order.status === 'pending' ? 'bg-gray-600' : order.status === 'preparing' ? 'bg-amber-700' : 'bg-primary-700' %>"><%= order.status %></span>
              <h2 class="text-lg font-semibold mb-1">
                <a href="/orders/<%= order._id %>" class="text-gray-900 hover:text-primary-700">Order from <%= order.createdAt.toDateString() %></a>
              </h2>
              <p class="text-gray-600">$<%= order.totalPrice.toFixed(2) %></p>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
