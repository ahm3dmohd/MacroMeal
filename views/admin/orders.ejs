<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'All Orders' }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <h1 class="text-2xl font-bold mb-6">All Orders</h1>
      <% if (orders.length === 0) { %>
        <p class="text-center text-gray-500 border border-dashed border-gray-300 rounded-lg py-12">No orders yet.</p>
      <% } else { %>
        <ul class="bg-white rounded-lg shadow divide-y divide-gray-100">
          <% orders.forEach(function(order) { %>
            <li class="flex items-center justify-between gap-4 p-4">
              <div>
                <p class="font-semibold"><%= order.owner.username %> — <%= order.createdAt.toDateString() %></p>
                <p class="text-sm text-gray-500">$<%= order.totalPrice.toFixed(2) %></p>
              </div>
              <form action="/admin/orders/<%= order._id %>/status?_method=PUT" method="post" class="flex items-center gap-2">
                <select name="status" class="rounded-md border border-gray-300 px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600">
                  <option value="pending" <%= order.status === "pending" ? "selected" : "" %>>Pending</option>
                  <option value="preparing" <%= order.status === "preparing" ? "selected" : "" %>>Preparing</option>
                  <option value="delivered" <%= order.status === "delivered" ? "selected" : "" %>>Delivered</option>
                </select>
                <button type="submit" class="text-sm font-semibold text-primary-700 hover:text-primary-800">Update</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
