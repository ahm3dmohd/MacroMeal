<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: 'Manage Users' }) %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/navbar') %>
    <main class="max-w-5xl mx-auto px-4 pb-12">
      <h1 class="text-2xl font-bold mb-6">Manage Users</h1>
      <div class="bg-white rounded-lg shadow divide-y divide-gray-100">
        <% users.forEach(function(u) { %>
          <div class="flex items-center justify-between gap-4 p-4">
            <div>
              <p class="font-semibold"><%= u.username %></p>
              <p class="text-sm text-gray-500"><%= u.email %></p>
            </div>
            <form action="/admin/users/<%= u._id %>/role?_method=PUT" method="post" class="flex items-center gap-2">
              <select name="role" class="rounded-md border border-gray-300 px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-primary-600 focus:border-primary-600">
                <option value="user" <%= u.role === "user" ? "selected" : "" %>>User</option>
                <option value="vendor" <%= u.role === "vendor" ? "selected" : "" %>>Vendor</option>
                <option value="admin" <%= u.role === "admin" ? "selected" : "" %>>Admin</option>
              </select>
              <button type="submit" class="text-sm font-semibold text-primary-700 hover:text-primary-800">Update</button>
            </form>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
